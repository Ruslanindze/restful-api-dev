{
  "priority": 20,
  "request": {
    "method": "POST",
    "url": "/objects",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.name && @.name != null && @.data && @.data != null)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "bodyFileName": "public/post-object-response.json",
    "headers": { "Content-Type": "application/json" }
  }
}
